{
  "type": "object",
  "properties": {
    "call_type": {
      "type": "string",
      "enum": ["room_booking", "table_booking", "room_service", "guest_request",
               "question", "no_action"]
    },
    "language": { "type": "string", "minLength": 2, "maxLength": 2 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "caller": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "reservation_ref": { "type": ["string", "null"] },
    "booking": {
      "type": ["object", "null"],
      "properties": {
        "room_type": { "type": ["string", "null"] },
        "checkin": { "type": ["string", "null"] },
        "checkout": { "type": ["string", "null"] },
        "guests": { "type": ["integer", "null"] },
        "date": { "type": ["string", "null"] },
        "time": { "type": ["string", "null"] },
        "party_size": { "type": ["integer", "null"] },
        "dietary_notes": { "type": ["string", "null"] },
        "special_requests": { "type": ["string", "null"] },
        "room_number": { "type": ["string", "null"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "qty": { "type": "integer", "minimum": 1 }
            },
            "required": ["name"],
            "additionalProperties": false
          }
        },
        "notes": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "guest_request": {
      "type": ["object", "null"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["transport", "housekeeping", "maintenance", "concierge",
                   "dining", "other"]
        },
        "details": { "type": "string", "maxLength": 400 },
        "room_number": { "type": ["string", "null"] }
      },
      "required": ["category", "details"],
      "additionalProperties": false
    },
    "missing_info": {
      "type": "array",
      "items": { "type": "string" }
    },
    "escalation": {
      "type": ["object", "null"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["complaint", "safety", "payment", "policy_exception",
                   "missing_info", "vip", "urgent_transfer"]
        },
        "reason": { "type": "string", "maxLength": 300 }
      },
      "required": ["category", "reason"],
      "additionalProperties": false
    },
    "reason": { "type": "string", "maxLength": 300 }
  },
  "required": ["call_type", "language", "confidence"],
  "additionalProperties": false
}
